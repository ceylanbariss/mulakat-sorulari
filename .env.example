# ─── Firebase Configuration ───────────────────────────────────────────────────
# 1. Firebase Console → https://console.firebase.google.com
# 2. Projen → Project Settings → Your apps → Web app → firebaseConfig
# 3. Bu satırların başındaki # işaretini kaldır ve değerleri yapıştır

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Admin Panel ─────────────────────────────────────────────────────────────
# Admin olacak e-posta adreslerini virgülle ayırarak gir
# Örnek: VITE_ADMIN_EMAILS=admin@example.com,diger@example.com
VITE_ADMIN_EMAILS=

# ─── AI Mülakat Simülasyonu ───────────────────────────────────────────────────
# Google Gemini API anahtarı (console.cloud.google.com → AI Studio → API Keys)
# Vercel Dashboard → Settings → Environment Variables'a da ekle
# NOT: Bu değişken VITE_ prefix'i almaz — sadece sunucu tarafında kullanılır
GEMINI_API_KEY=
